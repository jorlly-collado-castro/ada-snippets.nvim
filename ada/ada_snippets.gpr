with "aunit";

project Ada_Snippets is

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("gen_snippets.adb", "test_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2");
   end Compiler;

end Ada_Snippets;
