with Ada.Strings.Unbounded; use Ada.Strings.Unbounded;

package body Definitions is

   function "+" (S : String) return Unbounded_String
     renames To_Unbounded_String;

   function All_Snippets return Snippet_Array is
   begin
      return Snippet_Array'
        (1 =>
           (Prefix      => +"proc",
            Body        => +"procedure ${1:Name} is\n  ${2}\nbegin\n  ${3:-- body}\nend ${1:Name};",
            Description => +"procedure body",
            Standards   => All_Standards,
            With_Units  => +""),
         2 =>
           (Prefix      => +"procs",
            Body        => +"procedure ${1:Name} (${2:Param} : ${3:Type});",
            Description => +"procedure specification (declaration)",
            Standards   => All_Standards,
            With_Units  => +""),
         3 =>
           (Prefix      => +"func",
            Body        => +"function ${1:Name} (${2:Param} : ${3:Type}) return ${4:Return_Type}\n  ${5}\nbegin\n  ${6:-- body}\nend ${1:Name};",
            Description => +"function body",
            Standards   => All_Standards,
            With_Units  => +""),
         4 =>
           (Prefix      => +"funcs",
            Body        => +"function ${1:Name} (${2:Param} : ${3:Type}) return ${4:Return_Type};",
            Description => +"function specification (declaration)",
            Standards   => All_Standards,
            With_Units  => +""),
         5 =>
           (Prefix      => +"pkg",
            Body        => +"package ${1:Name} is\n  ${2}\nend ${1:Name};",
            Description => +"package specification",
            Standards   => All_Standards,
            With_Units  => +""),
         6 =>
           (Prefix      => +"pkgb",
            Body        => +"package body ${1:Name} is\n  ${2}\nbegin\n  ${3}\nend ${1:Name};",
            Description => +"package body",
            Standards   => All_Standards,
            With_Units  => +""),
         7 =>
