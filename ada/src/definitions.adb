            Description => +"task specification",
            Standards   => Ravenscar_Compat,
            With_Units  => +""),
         8 =>
           (Prefix      => +"taskb",
            Body        => +"task body ${1:Name} is\n  ${2}\nbegin\n  ${3:-- body}\nend ${1:Name};",
