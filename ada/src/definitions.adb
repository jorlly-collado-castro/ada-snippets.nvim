            Standards   => All_Standards,
            With_Units  => +""),
         37 =>
           (Prefix      => +"enum",
            Body        => +"type ${1:Name} is (${2:Element_1}, ${3:Element_2});",
            Description => +"enumeration type",
            Standards   => All_Standards,
            With_Units  => +""),
         38 =>
           (Prefix      => +"access",
            Body        => +"type ${1:Name} is access ${2:Target_Type};",
